# MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/gt_leads"

# CSV download: /api/leads/export?key=<ADMIN_KEY>  (add &type=calls for the call log)
ADMIN_KEY=change-me

# Exotel Passthru URL: https://<domain>/api/exotel/call?key=<EXOTEL_KEY>
EXOTEL_KEY=change-me

# Meta WhatsApp webhook: https://<domain>/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=change-me      # same value you type in Meta's webhook setup
WHATSAPP_APP_SECRET=                 # Meta app secret, used to verify X-Hub-Signature-256

# Optional: every new lead is also POSTed here as JSON (CRM, Google Sheets, Zapier, etc.)
LEAD_WEBHOOK_URL=

# Admin panel login at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Interakt: WhatsApp template sent to every Exotel caller
INTERAKT_API_KEY=                    # the value after "Basic " in Interakt's curl
INTERAKT_TEMPLATE_NAME=test1
INTERAKT_TEMPLATE_LANG=en
INTERAKT_HEADER_MEDIA_URL=           # public https URL of the template's header image/video/PDF (leave empty if no media header)
INTERAKT_HEADER_FILE_NAME=           # only for a PDF/document header, e.g. GT-Partner.pdf
WA_RESEND_HOURS=24                   # don't re-send to the same number within this window (0 = always send)
WA_THANK_YOU_MESSAGE="Thanks for filling the form"   # sent right after a form is submitted; leave empty to turn off
INTERAKT_WEBHOOK_SECRET=             # secret key you set in Interakt Developer Settings → Webhook
