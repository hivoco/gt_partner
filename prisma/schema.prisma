generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// One row per Exotel call, written by the Passthru applet (/api/exotel/call).
model Call {
  id        String   @id @default(uuid()) @db.Char(36)
  callSid   String   @unique @map("call_sid") @db.VarChar(64)
  callFrom  String   @map("call_from") @db.VarChar(20) // as sent by Exotel, e.g. 09876543210
  phone     String?  @db.VarChar(10) // normalised 10-digit mobile, null for landlines/invalid
  callTo    String?  @map("call_to") @db.VarChar(20)
  direction String?  @db.VarChar(20)
  callType  String?  @map("call_type") @db.VarChar(40)
  startTime String?  @map("start_time") @db.VarChar(30)
  raw       Json
  // WhatsApp template sent via Interakt after the call
  waStatus    String?   @map("wa_status") @db.VarChar(20) // pending | sent | failed | skipped
  waMessageId String?   @map("wa_message_id") @db.VarChar(100)
  waError     String?   @map("wa_error") @db.VarChar(255)
  waSentAt    DateTime? @map("wa_sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@index([phone, waSentAt])
  @@index([createdAt])
  @@map("calls")
}

model Lead {
  id               String   @id @default(uuid()) @db.Char(36)
  name             String   @db.VarChar(120)
  phone            String   @db.VarChar(10)
  state            String   @db.VarChar(60)
  city             String   @db.VarChar(80)
  storeName        String   @map("store_name") @db.VarChar(150)
  existingRetailer Boolean  @map("existing_retailer")
  consent          Boolean  @default(false)
  source           String   @default("whatsapp") @db.VarChar(50)
  duplicate        Boolean  @default(false) // true if this phone had already registered
  callSid          String?  @map("call_sid") @db.VarChar(64) // latest missed call from this phone
  waMessageId      String?  @unique @map("wa_message_id") @db.VarChar(128) // guards against webhook retries
  flowToken        String?  @map("flow_token") @db.VarChar(128)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@index([createdAt])
  @@map("leads")
}
